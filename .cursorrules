## Component Template
```tsx
'use client'                          // add only if using hooks/GSAP/events

import { useEffect, useRef } from 'react'
import { cn } from '@/lib/utils'

interface ExampleProps {
  className?: string
  // all props typed here
}

export function ExampleComponent({ className }: ExampleProps) {
  const ref = useRef<HTMLDivElement>(null)

  useEffect(() => {
    // GSAP animations here
    return () => ScrollTrigger.getAll().forEach(t => t.kill())
  }, [])

  return (
    <section className={cn('py-24 md:py-32 px-6 md:px-12 lg:px-20 bg-brand-black', className)}>
      {/* content */}
    </section>
  )
}
```

