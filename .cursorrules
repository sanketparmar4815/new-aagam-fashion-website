## Static Data Types
```ts
interface Product {
  id: string; slug: string; name: string
  category: 'clothing' | 'fabric' | 'tailoring'
  price: number; currency: string; images: string[]
  collection: string; description: string; featured: boolean; tags: string[]
  details: { material: string; origin: string; care: string }
}

interface Fabric {
  id: string; slug: string; name: string; origin: string
  pricePerMeter: number; images: string[]; colors: string[]
  composition: string; weight: string; width: string; moq: number
}

interface Collection {
  id: string; slug: string; name: string; season: string
  coverImage: string; description: string; products: string[]
}
```

